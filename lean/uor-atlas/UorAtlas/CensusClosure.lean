  | r :: rs => if r.1 = g then r.2 else lookupPacked g rs

@[expose] public def gramInversePack (g : Nat) : Nat := lookupPacked g gramInverseRows

/-- Membership mask for the 393 positive Gram types.  Consulting it before
the witness search prevents the positive cases from scanning all 625
candidate bad vectors. -/
@[expose] public def positiveGramMask : Nat := 

@[expose] public def positiveGram (g : Nat) : Bool := positiveGramMask.testBit g

@[expose] public def certScale (p : Nat) : Int := ((p &&& 8191 : Nat) : Int)

@[expose] public def certAdj (p : Nat) : Mat 4 4 Int :=
  fun i j => ((((p >>> (13 + 11 * (4 * i.val + j.val))) &&& 2047 : Nat) : Int) - 512)

/-- `u = adj(G)d`, the denominator-free coordinate column. -/
@[expose] public def coordNum (p d : Nat) : Vec 4 Int :=
  Mat.apply (certAdj p) (pairVec d)

/-- A positive scaled inverse, checked entrywise rather than trusted from the
packed certificate. -/
@[expose] public def inverseCert (g p : Nat) : Bool :=
  decide (0 < certScale p)
    && allFin (fun i : Fin 4 => allFin (fun j : Fin 4 =>
      decide (Mat.mul (certAdj p) (gramType g) i j
        = if i = j then certScale p else 0)))
    && allFin (fun i : Fin 4 => allFin (fun j : Fin 4 =>
      decide (Mat.mul (gramType g) (certAdj p) i j
        = if i = j then certScale p else 0)))

/-- The small coefficient vectors used to refute non-positive Gram types. -/
@[expose] public def smallVec (n : Nat) : Vec 4 Int :=
  fun i => (((n / 5 ^ i.val) % 5 : Nat) : Int) - 2

@[expose] public def badVectorOK (g n : Nat) : Bool :=
  decide (n < 625)
    && (decide (smallVec n 0 != 0) || decide (smallVec n 1 != 0)
      || decide (smallVec n 2 != 0) || decide (smallVec n 3 != 0))
    && decide (form4 (gramType g) (smallVec n) (smallVec n) <= 0)

/-- Search used while constructing the compact witness register below.  It is
not part of the final certificate: every registered vector is checked again. -/
@[expose] public def findBad (g : Nat) : Nat -> Nat
  | 0 => 0
  | n + 1 => if badVectorOK g n then n else findBad g n

