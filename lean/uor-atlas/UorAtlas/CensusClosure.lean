/-- A non-positive Gram type carries one explicitly checked small vector. -/
@[expose] public def badGramCert (g : Nat) : Bool :=
  badVectorOK g (badGramWitness g)

/-- Pairing columns are quotiented by sign by keeping the larger of the two
base-five codes.  Negation sends code `n` to `624-n`, and `312` is zero. -/
@[expose] public def rootColumnOK (g p d : Nat) : Bool :=
  decide (312 < d) && decide (d < 625)
    && decide (form4 (gramType g) (coordNum p d) (coordNum p d)
      = 8 * certScale p * certScale p)

@[expose] public def rootColumnCount (g p : Nat) : Nat -> Nat
  | 0 => 0
  | n + 1 => rootColumnCount g p n + if rootColumnOK g p n then 1 else 0

@[expose] public def crossNum (g p d e : Nat) : Int :=
  form4 (gramType g) (coordNum p d) (coordNum p e)

/-- Four ten-bit column codes packed into one natural. -/
@[expose] public def quadColumn (p : Nat) (i : Fin 4) : Nat :=
  (p >>> (10 * i.val)) &&& 1023

