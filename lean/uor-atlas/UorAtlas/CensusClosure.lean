@[expose] public def lookupQuad (g : Nat) : List (Nat × Nat) -> Nat
  | [] => 0
  | r :: rs => if r.1 = g then r.2 else lookupQuad g rs

@[expose] public def gramQuad (g : Nat) : Nat := lookupQuad g gramQuadRows

/-- The selected columns are roots and mutually orthogonal, and their four
Parseval pairings cover every admissible column. -/
@[expose] public def quadColumnsOK (g ip : Nat) : Bool :=
  let q := gramQuad g
  allFin (fun i : Fin 4 => rootColumnOK g ip (quadColumn q i))
    && allFin (fun i : Fin 4 => allFin (fun j : Fin 4 =>
      decide (i = j) || decide (crossNum g ip (quadColumn q i) (quadColumn q j) = 0)))
    && allLt (fun d => !rootColumnOK g ip d || decide (
      crossNum g ip d (quadColumn q 0) * crossNum g ip d (quadColumn q 0)
        + crossNum g ip d (quadColumn q 1) * crossNum g ip d (quadColumn q 1)
        + crossNum g ip d (quadColumn q 2) * crossNum g ip d (quadColumn q 2)
        + crossNum g ip d (quadColumn q 3) * crossNum g ip d (quadColumn q 3)
      = 64 * certScale ip * certScale ip * certScale ip * certScale ip)) 625

/-- One Gram type either has an explicit non-positive vector, or has the
positive inverse, twelve-column bound, and a spanning orthogonal quadruple at
equality. -/
@[expose] public def gramCaseOK (g : Nat) : Bool :=
  if positiveGram g then
    let p := gramInversePack g
    inverseCert g p
      && decide (rootColumnCount g p 625 <= 12)
      && (!decide (rootColumnCount g p 625 = 12) || quadColumnsOK g p)
  else badGramCert g

/-! ### Encoding an arbitrary block basis -/

/-- Membership in the five-value pairing alphabet. -/
@[expose] public def PairValue (x : Int) : Prop :=
  x = -8 ∨ x = -4 ∨ x = 0 ∨ x = 4 ∨ x = 8

/-- The inverse digit map on the five-value alphabet. -/
@[expose] public def pairDigit (x : Int) : Nat := (x + 8).toNat / 4

@[expose] public def censusIdx4 (k : Nat) : Fin 4 := ⟨k % 4, Nat.mod_lt _ (by decide)⟩

public theorem censusIdx4_val (i : Fin 4) : censusIdx4 i.val = i :=
  Fin.eq_of_val_eq (Nat.mod_eq_of_lt i.isLt)

/-- Four pairing values encoded in base five. -/
@[expose] public def pairCode (d : Vec 4 Int) : Nat :=
  pk 5 (fun k => pairDigit (d (censusIdx4 k))) 4

public theorem pairVal_pairDigit {x : Int} (h : PairValue x) :
    pairVal (pairDigit x) = x := by
  rcases h with h | h | h | h | h <;> rw [h] <;> decide

public theorem pairDigit_lt {x : Int} (h : PairValue x) : pairDigit x < 5 := by
  rcases h with h | h | h | h | h <;> rw [h] <;> decide

public theorem pairCode_lt {d : Vec 4 Int} (h : ∀ i, PairValue (d i)) :
    pairCode d < 625 := by
  have hp := pk_lt 5 (fun k => pairDigit (d (censusIdx4 k))) 4
    (fun k _ => pairDigit_lt (h (censusIdx4 k)))
  exact hp

public theorem pairVec_pairCode {d : Vec 4 Int} (h : ∀ i, PairValue (d i)) :
    pairVec (pairCode d) = d := by
  funext i
  have hd := pk_digit 5 (by decide) (fun k => pairDigit (d (censusIdx4 k))) 4
    (fun k _ => pairDigit_lt (h (censusIdx4 k))) i.val i.isLt
  show 4 * ((((pairCode d / 5 ^ i.val) % 5 : Nat) : Int) - 2) = d i
  simp only [pairCode]
  rw [hd, censusIdx4_val]
  have hv := pairVal_pairDigit (h i)
  rw [pairVal, Nat.mod_eq_of_lt (pairDigit_lt (h i))] at hv
  exact hv

public theorem pairDigit_neg {x : Int} (h : PairValue x) :
    pairDigit (-x) = 4 - pairDigit x := by
  rcases h with h | h | h | h | h <;> rw [h] <;> decide

public theorem pk_congr (B m : Nat) {f g : Nat -> Nat} (h : ∀ k, k < m -> f k = g k) :
    pk B f m = pk B g m := by
  induction m with
  | zero => rfl
  | succ n ih =>
      rw [pk_succ, pk_succ, h n (Nat.lt_succ_self n), ih (fun k hk => h k (by omega))]

public theorem pk_complement (v : Nat -> Nat) : ∀ m : Nat,
    (∀ k, k < m -> v k < 5) ->
      pk 5 (fun k => 4 - v k) m + pk 5 v m = 5 ^ m - 1 := by
  intro m h
  induction m with
  | zero => rfl
  | succ n ih =>
      have ih' := ih (fun k hk => h k (by omega))
      have hn := h n (Nat.lt_succ_self n)
      rw [pk_succ, pk_succ, Nat.pow_succ]
      have hc : v n = 0 ∨ v n = 1 ∨ v n = 2 ∨ v n = 3 ∨ v n = 4 := by omega
      rcases hc with hc | hc | hc | hc | hc <;> rw [hc] <;> omega

public theorem pairCode_neg {d : Vec 4 Int} (h : ∀ i, PairValue (d i)) :
    pairCode (fun i => -(d i)) = 624 - pairCode d := by
  have hc := pk_complement (fun k => pairDigit (d (censusIdx4 k))) 4
    (fun k _ => pairDigit_lt (h (censusIdx4 k)))
  have he : pairCode (fun i => -(d i)) =
      pk 5 (fun k => 4 - pairDigit (d (censusIdx4 k))) 4 := by
    apply pk_congr
    intro k hk
    exact pairDigit_neg (h (censusIdx4 k))
  rw [he]
  simp only [pairCode]
  omega

/-- Inner products of arbitrary roots have the same five-value alphabet as
the representative table.  Equality of classes supplies `+-8`; distinct
classes reduce to `dotTri`, with the two independent sign choices restored. -/
public theorem root_dot_five {x y : Vec 8 Int} (hx : D11 x) (hy : D11 y) :
    PairValue (dot x y) := by
  by_cases hc : D12 x = D12 y
  · rcases (D12_eq_iff hx hy).mp hc with h | h
    · rw [h, hx.2]
      exact Or.inr (Or.inr (Or.inr (Or.inr rfl)))
    · rw [h, dot_neg_right, hx.2]
      exact Or.inl rfl
  · have ht := dot_tri (D12 x).isLt (D12 y).isLt
        (fun h => hc (Fin.eq_of_val_eq h))
    change dot (rep (D12 x)) (rep (D12 y)) = 0 ∨
      dot (rep (D12 x)) (rep (D12 y)) = 4 ∨
      dot (rep (D12 x)) (rep (D12 y)) = -4 at ht
    rcases T6.2 x hx with sx | sx <;> rcases T6.2 y hy with sy | sy
    · rw [sx, sy] at ht
      rcases ht with h | h | h
      · exact Or.inr (Or.inr (Or.inl h))
      · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
      · exact Or.inr (Or.inl h)
    · rw [sx, sy, dot_neg_right] at ht
      rcases ht with h | h | h
      · exact Or.inr (Or.inr (Or.inl (by omega)))
      · exact Or.inr (Or.inl (by omega))
      · exact Or.inr (Or.inr (Or.inr (Or.inl (by omega))))
    · rw [sx, sy, dot_neg_left] at ht
      rcases ht with h | h | h
      · exact Or.inr (Or.inr (Or.inl (by omega)))
      · exact Or.inr (Or.inl (by omega))
      · exact Or.inr (Or.inr (Or.inr (Or.inl (by omega))))
    · rw [sx, sy, dot_neg_left, dot_neg_right] at ht
      rcases ht with h | h | h
      · exact Or.inr (Or.inr (Or.inl (by omega)))
      · exact Or.inr (Or.inr (Or.inr (Or.inl (by omega))))
      · exact Or.inr (Or.inl (by omega))

/-- The six upper-triangular positions in the order used by `gramType`. -/
@[expose] public def gramLeft : Nat -> Fin 4
  | 0 | 1 | 2 => 0
  | 3 | 4 => 1
  | _ => 2

@[expose] public def gramRight : Nat -> Fin 4
  | 0 => 1
  | 1 => 2
  | 2 => 3
  | 3 => 2
  | 4 => 3
  | _ => 3

@[expose] public def basisGram (b : Fin 4 -> Vec 8 Int) : Mat 4 4 Int :=
  fun i j => dot (b i) (b j)

@[expose] public def gramCode (b : Fin 4 -> Vec 8 Int) : Nat :=
  pk 5 (fun k => pairDigit (dot (b (gramLeft k)) (b (gramRight k)))) 6

public theorem gramCode_lt {b : Fin 4 -> Vec 8 Int} (hb : ∀ i, D11 (b i)) :
    gramCode b < 15625 := by
  exact pk_lt 5 (fun k => pairDigit (dot (b (gramLeft k)) (b (gramRight k)))) 6
    (fun k _ => pairDigit_lt (root_dot_five (hb _) (hb _)))

public theorem gramCode_digit {b : Fin 4 -> Vec 8 Int} (hb : ∀ i, D11 (b i))
    (k : Nat) (hk : k < 6) :
    pairVal (gramCode b / 5 ^ k) = dot (b (gramLeft k)) (b (gramRight k)) := by
  have hd := pk_digit 5 (by decide)
    (fun n => pairDigit (dot (b (gramLeft n)) (b (gramRight n)))) 6
    (fun n _ => pairDigit_lt (root_dot_five (hb _) (hb _))) k hk
  show 4 * ((((gramCode b / 5 ^ k) % 5 : Nat) : Int) - 2) = _
  simp only [gramCode]
  rw [hd]
  have hv := pairVal_pairDigit (root_dot_five (hb (gramLeft k)) (hb (gramRight k)))
  rw [pairVal, Nat.mod_eq_of_lt
    (pairDigit_lt (root_dot_five (hb (gramLeft k)) (hb (gramRight k))))] at hv
  exact hv

public theorem gramType_gramCode {b : Fin 4 -> Vec 8 Int} (hb : ∀ i, D11 (b i)) :
    gramType (gramCode b) = basisGram b := by
  have e0 := gramCode_digit hb 0 (by decide)
  have e1 := gramCode_digit hb 1 (by decide)
  have e2 := gramCode_digit hb 2 (by decide)
  have e3 := gramCode_digit hb 3 (by decide)
  have e4 := gramCode_digit hb 4 (by decide)
  have e5 := gramCode_digit hb 5 (by decide)
  funext i j
  refine fin4 (P := fun a => gramType (gramCode b) a j = basisGram b a j)
    ?_ ?_ ?_ ?_ i <;>
    refine fin4 (P := fun c => gramType (gramCode b) _ c = basisGram b _ c)
      ?_ ?_ ?_ ?_ j
  all_goals
    simp [gramType, gramSlot, basisGram, gramLeft, gramRight,
      Nat.min_def, Nat.max_def] at e0 e1 e2 e3 e4 e5 ⊢
  · exact (hb 0).2.symm
  · exact e0
  · exact e1
  · exact e2
  · rw [dot_comm]; exact e0
  · exact (hb 1).2.symm
  · exact e3
  · exact e4
  · rw [dot_comm]; exact e1
  · rw [dot_comm]; exact e3
  · exact (hb 2).2.symm
  · exact e5
  · rw [dot_comm]; exact e2
  · rw [dot_comm]; exact e4
  · rw [dot_comm]; exact e5
  · exact (hb 3).2.symm

/-- Evaluating the encoded Gram form is the squared norm of the corresponding
integer combination of basis roots.  This is the algebraic bridge used to
reject every non-positive finite Gram case. -/
public theorem form4_basisGram (b : Fin 4 -> Vec 8 Int) (z w : Vec 4 Int) :
    form4 (basisGram b) z w = dot (comb4 z b) (comb4 w b) := by
  rw [dot_comb4_left, dot_comb4_right, dot_comb4_right,
    dot_comb4_right, dot_comb4_right]
  simp only [form4, basisGram, sumInt4]
  simp only [Int.mul_comm]

/-- Extending the integral four-term combination to `Q` agrees with `qComb`.
It lets `D16`'s rational independence consume an integral zero relation. -/
public theorem qComb_int_comb4 (b : Fin 4 -> Vec 8 Int) (z : Vec 4 Int) (j : Fin 8) :
    qComb b (fun i => ((z i : Int) : Rat)) j = qOf (comb4 z b) j := by
  show Vec.sum (fun i : Fin 4 =>
      ((z i : Int) : Rat) * ((b i j : Int) : Rat)) =
    ((comb4 z b j : Int) : Rat)
  rw [show Vec.sum (fun i : Fin 4 =>
      ((z i : Int) : Rat) * ((b i j : Int) : Rat)) =
      Vec.sum (fun i : Fin 4 => ((z i * b i j : Int) : Rat)) by
        exact Vec.sum_congr (fun i => (Rat.intCast_mul (z i) (b i j)).symm)]
  calc
    Vec.sum (fun i : Fin 4 => ((z i * b i j : Int) : Rat)) =
        ((Vec.sumInt (fun i : Fin 4 => z i * b i j) : Int) : Rat) :=
      (hom_map_sum NumInstances.intToRat (fun i : Fin 4 => z i * b i j)).symm
    _ = ((comb4 z b j : Int) : Rat) := by
      congr 1
      rw [sumInt4]
      change _ = (z 0 * b 0 j + z 1 * b 1 j) + (z 2 * b 2 j + z 3 * b 3 j)
      omega

public theorem integral_relation_zero {b : Fin 4 -> Vec 8 Int} (hind : Indep b)
    {z : Vec 4 Int} (hz : ∀ j : Fin 8, comb4 z b j = 0) : ∀ i, z i = 0 := by
  have hq : ∀ j : Fin 8, qComb b (fun i => ((z i : Int) : Rat)) j = 0 := by
    intro j
    rw [qComb_int_comb4]
    exact congrArg (fun x : Int => (x : Rat)) (hz j)
  intro i
  exact Rat.intCast_eq_zero_iff.mp (hind (fun i => ((z i : Int) : Rat)) hq i)

/-- A `D16` basis cannot inhabit the non-positive side of the finite Gram
classification: its checked bad vector would be a nonzero linear relation. -/
public theorem badGram_impossible {b : Fin 4 -> Vec 8 Int} (hb : ∀ i, D11 (b i))
    (hind : Indep b) : badGramCert (gramCode b) ≠ true := by
  intro hbad
  simp only [badGramCert, badVectorOK, Bool.and_eq_true, Bool.or_eq_true,
    decide_eq_true_eq] at hbad
  let z := smallVec (badGramWitness (gramCode b))
  have hform : form4 (basisGram b) z z ≤ 0 := by
    rw [← gramType_gramCode hb]
    exact hbad.2
  have hle : dot (comb4 z b) (comb4 z b) ≤ 0 := by
    rw [← form4_basisGram]
    exact hform
  have hnonneg : 0 ≤ dot (comb4 z b) (comb4 z b) :=
    sumInt_nonneg _ (fun i => mul_self_nonneg _)
  have hzero : dot (comb4 z b) (comb4 z b) = 0 := Int.le_antisymm hle hnonneg
  have hz := integral_relation_zero hind (dot_self_zero hzero)
  rcases hbad.1.2 with ((h | h) | h) | h
  · exact (bne_iff_ne.mp h) (hz 0)
  · exact (bne_iff_ne.mp h) (hz 1)
  · exact (bne_iff_ne.mp h) (hz 2)
  · exact (bne_iff_ne.mp h) (hz 3)

@[expose] public def pairing (b : Fin 4 -> Vec 8 Int) (y : Vec 8 Int) : Vec 4 Int :=
  fun i => dot y (b i)

public theorem pairing_five {b : Fin 4 -> Vec 8 Int} (hb : ∀ i, D11 (b i))
    {y : Vec 8 Int} (hy : D11 y) : ∀ i, PairValue (pairing b y i) :=
  fun i => root_dot_five hy (hb i)

@[expose] public def scaledId (s : Int) : Mat 4 4 Int :=
  fun i j => if i = j then s else 0

public theorem inverseCert_scale {g p : Nat} (h : inverseCert g p = true) :
    0 < certScale p := by
  simp only [inverseCert, Bool.and_eq_true, decide_eq_true_eq] at h
  exact h.1.1

public theorem inverseCert_left {g p : Nat} (h : inverseCert g p = true) :
    Mat.mul (certAdj p) (gramType g) = scaledId (certScale p) := by
  simp only [inverseCert, Bool.and_eq_true, decide_eq_true_eq] at h
  funext i j
  exact of_decide_eq_true (allFin_true _ (allFin_true _ h.1.2 i) j)

/-- Extension of scalars commutes with an integral matrix action. -/
public theorem map_apply_intToRat (A : Mat 4 4 Int) (x : Vec 4 Int) :
    Vec.map NumInstances.intToRat (Mat.apply A x) =
      Mat.apply (Mat.map NumInstances.intToRat A) (Vec.map NumInstances.intToRat x) := by
  funext i
  show ((Vec.sumInt (fun j => A i j * x j) : Int) : Rat) =
    Vec.sum (fun j => ((A i j : Int) : Rat) * ((x j : Int) : Rat))
  rw [Vec.sumInt_eq_sum]
  exact Eq.trans (hom_map_sum NumInstances.intToRat (fun j => A i j * x j))
    (Vec.sum_congr (fun j => Rat.intCast_mul (A i j) (x j)))

public theorem apply_mapped_scaledId (s : Int) (x : Vec 4 Rat) :
    Mat.apply (Mat.map NumInstances.intToRat (scaledId s)) x =
      fun i => ((s : Int) : Rat) * x i := by
  funext i
  show Vec.sum (fun j => ((if i = j then s else 0 : Int) : Rat) * x j) = _
  have ht : ∀ j : Fin 4, ((if i = j then s else 0 : Int) : Rat) * x j =
      if i = j then ((s : Int) : Rat) * x j else 0 := by
    intro j
    by_cases hij : i = j
    · rw [if_pos hij, if_pos hij]
    · rw [if_neg hij, if_neg hij]
      exact zero_mul _
  rw [Vec.sum_congr ht]
  exact Vec.sum_ite_eq i (fun j => ((s : Int) : Rat) * x j)

/-- Pairing a vector in the basis span records the Gram matrix applied to its
rational coordinate column. -/
public theorem pairing_matrix (b : Fin 4 -> Vec 8 Int) (y : Vec 8 Int) (c : Vec 4 Rat)
    (hy : ∀ j : Fin 8, qOf y j = qComb b c j) :
    Vec.map NumInstances.intToRat (pairing b y) =
      Mat.apply (Mat.map NumInstances.intToRat (basisGram b)) c := by
  have hq : qOf y = qComb b c := funext hy
  funext i
  calc
    ((pairing b y i : Int) : Rat) = Vec.inner (qOf y) (qOf (b i)) :=
      (inner_qOf y (b i)).symm
    _ = Vec.inner (qComb b c) (qOf (b i)) := by rw [hq]
    _ = Vec.sum (fun j => c j * Vec.inner (qOf (b j)) (qOf (b i))) :=
      inner_qComb b c (qOf (b i))
    _ = Vec.sum (fun j => ((basisGram b i j : Int) : Rat) * c j) := by
      refine Vec.sum_congr (fun j => ?_)
      rw [inner_qOf, basisGram, dot_comm (b j) (b i), Rat.mul_comm]
    _ = Mat.apply (Mat.map NumInstances.intToRat (basisGram b)) c i := rfl

/-- The checked adjugate recovers scaled coordinates from a pairing column. -/
public theorem coordNum_of_span {g p : Nat} (hinv : inverseCert g p = true)
    (b : Fin 4 -> Vec 8 Int) (hgram : gramType g = basisGram b)
    (y : Vec 8 Int) (c : Vec 4 Rat) (hy : ∀ j : Fin 8, qOf y j = qComb b c j) :
    Vec.map NumInstances.intToRat (Mat.apply (certAdj p) (pairing b y)) =
      fun i => ((certScale p : Int) : Rat) * c i := by
  have hm : Mat.mul (certAdj p) (basisGram b) = scaledId (certScale p) := by
    rw [← hgram]
    exact inverseCert_left hinv
  rw [map_apply_intToRat, pairing_matrix b y c hy, ← Mat.apply_mul]
  rw [← M1 NumInstances.intToRat, hm, apply_mapped_scaledId]

public theorem inSpan_neg {b : Fin 4 -> Vec 8 Int} {y : Vec 8 Int}
    (hy : InSpan b (qOf y)) : InSpan b (qOf (AddCommGroup.neg y)) := by
  obtain ⟨c, hc⟩ := hy
  refine ⟨fun i => AddCommGroup.neg (c i), fun j => ?_⟩
  have hsum : qComb b (fun i => AddCommGroup.neg (c i)) j =
      AddCommGroup.neg (qComb b c j) := by
    show Vec.sum (fun i => (-c i) * ((b i j : Int) : Rat)) =
      -(Vec.sum (fun i => c i * ((b i j : Int) : Rat)))
    exact Eq.trans
      (Vec.sum_congr (fun i => neg_mul (c i) ((b i j : Int) : Rat)))
      (Vec.sum_neg (fun i => c i * ((b i j : Int) : Rat)))
  rw [hsum, ← hc j]
  exact Rat.intCast_neg (y j)

/-- The adjugate reconstruction stays integral: multiplying a root in the
span by the positive determinant gives the checked integral combination. -/
public theorem scaled_recon_of_span {g p : Nat} (hinv : inverseCert g p = true)
    (b : Fin 4 -> Vec 8 Int) (hb : ∀ i, D11 (b i))
    (hgram : gramType g = basisGram b) {y : Vec 8 Int} (hy : D11 y)
    (hspan : InSpan b (qOf y)) (j : Fin 8) :
    certScale p * y j = comb4 (coordNum p (pairCode (pairing b y))) b j := by
  obtain ⟨c, hc⟩ := hspan
  have hpair := pairVec_pairCode (pairing_five hb hy)
  have hu := coordNum_of_span hinv b hgram y c hc
  have hu' : Vec.map NumInstances.intToRat
      (coordNum p (pairCode (pairing b y))) =
      fun i => ((certScale p : Int) : Rat) * c i := by
    simp only [coordNum]
    rw [hpair]
    exact hu
  have hscale : qComb b (fun i => ((certScale p : Int) : Rat) * c i) j =
      ((certScale p : Int) : Rat) * qComb b c j := by
    show Vec.sum (fun i => (((certScale p : Int) : Rat) * c i) *
        ((b i j : Int) : Rat)) =
      ((certScale p : Int) : Rat) *
        Vec.sum (fun i => c i * ((b i j : Int) : Rat))
    exact Eq.trans (Vec.sum_congr (fun i => Rat.mul_assoc _ _ _))
      (Vec.mul_sum ((certScale p : Int) : Rat)
        (fun i => c i * ((b i j : Int) : Rat))).symm
  apply Rat.intCast_inj.mp
  calc
    (((certScale p * y j : Int)) : Rat) =
        ((certScale p : Int) : Rat) * ((y j : Int) : Rat) :=
      Rat.intCast_mul (certScale p) (y j)
    _ = ((certScale p : Int) : Rat) * qComb b c j := by
      exact congrArg (fun q => ((certScale p : Int) : Rat) * q) (hc j)
    _ = qComb b (fun i => ((certScale p : Int) : Rat) * c i) j := hscale.symm
    _ = qComb b (fun i => ((coordNum p (pairCode (pairing b y)) i : Int) : Rat)) j := by
      congr 1
      funext i
      exact (congrFun hu' i).symm
    _ = ((comb4 (coordNum p (pairCode (pairing b y))) b j : Int) : Rat) :=
      qComb_int_comb4 b _ j

/-- A root in the span whose sign-normalised pairing code is already above
the midpoint satisfies the finite oracle's root-column predicate. -/
public theorem rootColumn_of_span {g p : Nat} (hinv : inverseCert g p = true)
    (b : Fin 4 -> Vec 8 Int) (hb : ∀ i, D11 (b i))
    (hgram : gramType g = basisGram b) {y : Vec 8 Int} (hy : D11 y)
    (hspan : InSpan b (qOf y)) (hcanon : 312 < pairCode (pairing b y)) :
    rootColumnOK g p (pairCode (pairing b y)) = true := by
  simp only [rootColumnOK, Bool.and_eq_true, decide_eq_true_eq]
  refine ⟨⟨hcanon, pairCode_lt (pairing_five hb hy)⟩, ?_⟩
  let u := coordNum p (pairCode (pairing b y))
  have hr : ∀ j : Fin 8, certScale p * y j = comb4 u b j :=
    scaled_recon_of_span hinv b hb hgram hy hspan
  have hvec : Vec.smul (certScale p) y = comb4 u b := funext hr
  rw [hgram, form4_basisGram, ← hvec, dot_smul_left, dot_smul_right, hy.2]
  ac_rfl

public theorem pairing_ne_zero_of_span (b : Fin 4 -> Vec 8 Int) {y : Vec 8 Int}
    (hy : D11 y) (hspan : InSpan b (qOf y)) : pairing b y ≠ fun _ => 0 := by
  intro hzero
  obtain ⟨c, hc⟩ := hspan
  have hinner : Vec.inner (qComb b c) (qOf y) = (0 : Rat) := by
    rw [inner_qComb]
    have ht : ∀ i : Fin 4, mul (c i) (Vec.inner (qOf (b i)) (qOf y)) = 0 := by
      intro i
      rw [inner_qOf, dot_comm]
      have hi := congrFun hzero i
      simp only [pairing] at hi
      rw [hi]
      exact mul_zero _
    exact Eq.trans (Vec.sum_congr ht) Vec.sum_zero
  have hself : Vec.inner (qOf y) (qOf y) = (0 : Rat) :=
    Eq.trans (congrArg (fun v => Vec.inner v (qOf y)) (funext hc)) hinner
  rw [inner_qOf] at hself
  have hd : dot y y = 0 := Rat.intCast_eq_zero_iff.mp hself
  rw [hy.2] at hd
  contradiction

public theorem pairCode_ne_mid {b : Fin 4 -> Vec 8 Int} (hb : ∀ i, D11 (b i))
    {y : Vec 8 Int} (hy : D11 y) (hspan : InSpan b (qOf y)) :
    pairCode (pairing b y) ≠ 312 := by
  intro hmid
  have hp := pairVec_pairCode (pairing_five hb hy)
  apply pairing_ne_zero_of_span b hy hspan
  rw [← hp, hmid]
  decide

/-- Canonical pairing code for a root class: of the two antipodal columns,
retain the one strictly above the zero column `312`. -/
@[expose] public def canonicalCode (b : Fin 4 -> Vec 8 Int) (y : Vec 8 Int) : Nat :=
  let d := pairCode (pairing b y)
  if 312 < d then d else 624 - d

@[expose] public def canonicalRoot (b : Fin 4 -> Vec 8 Int) (y : Vec 8 Int) : Vec 8 Int :=
  if 312 < pairCode (pairing b y) then y else AddCommGroup.neg y

public theorem canonicalRoot_D11 (b : Fin 4 -> Vec 8 Int) {y : Vec 8 Int} (hy : D11 y) :
    D11 (canonicalRoot b y) := by
  by_cases h : 312 < pairCode (pairing b y)
  · simpa [canonicalRoot, h]
  · simpa [canonicalRoot, h] using D11_neg hy

public theorem canonicalRoot_span (b : Fin 4 -> Vec 8 Int) {y : Vec 8 Int}
    (hspan : InSpan b (qOf y)) : InSpan b (qOf (canonicalRoot b y)) := by
  by_cases h : 312 < pairCode (pairing b y)
  · simpa [canonicalRoot, h]
  · simpa [canonicalRoot, h] using inSpan_neg hspan

public theorem canonicalRoot_class (b : Fin 4 -> Vec 8 Int) {y : Vec 8 Int} (hy : D11 y) :
    D12 (canonicalRoot b y) = D12 y := by
  apply (D12_eq_iff (canonicalRoot_D11 b hy) hy).mpr
  by_cases h : 312 < pairCode (pairing b y)
  · exact Or.inl (by simp [canonicalRoot, h])
  · exact Or.inr (by simp [canonicalRoot, h, vneg_neg])

public theorem canonicalRoot_code {b : Fin 4 -> Vec 8 Int} (hb : ∀ i, D11 (b i))
    {y : Vec 8 Int} (hy : D11 y) :
    pairCode (pairing b (canonicalRoot b y)) = canonicalCode b y := by
  by_cases h : 312 < pairCode (pairing b y)
  · simp [canonicalRoot, canonicalCode, h]
  · have hp : pairing b (AddCommGroup.neg y) = fun i => -(pairing b y i) := by
      funext i
      exact dot_neg_left y (b i)
    rw [canonicalRoot, if_neg h, hp, pairCode_neg (pairing_five hb hy)]
    simp [canonicalCode, h]

/-- Equal canonical columns determine equal oriented roots.  The checked
positive scaled inverse turns equality of the pairings into coordinatewise
equality of the roots themselves. -/
public theorem canonicalRoot_injective {g p : Nat} (hinv : inverseCert g p = true)
    (b : Fin 4 -> Vec 8 Int) (hb : ∀ i, D11 (b i))
    (hgram : gramType g = basisGram b) {y z : Vec 8 Int} (hy : D11 y) (hz : D11 z)
    (hsy : InSpan b (qOf y)) (hsz : InSpan b (qOf z))
    (heq : canonicalCode b y = canonicalCode b z) :
    canonicalRoot b y = canonicalRoot b z := by
  let y' := canonicalRoot b y
  let z' := canonicalRoot b z
  have hy' : D11 y' := canonicalRoot_D11 b hy
  have hz' : D11 z' := canonicalRoot_D11 b hz
  have hsy' : InSpan b (qOf y') := canonicalRoot_span b hsy
  have hsz' : InSpan b (qOf z') := canonicalRoot_span b hsz
  have hcode : pairCode (pairing b y') = pairCode (pairing b z') := by
    rw [canonicalRoot_code hb hy, canonicalRoot_code hb hz]
    exact heq
  have hry := scaled_recon_of_span hinv b hb hgram hy' hsy'
  have hrz := scaled_recon_of_span hinv b hb hgram hz' hsz'
  have hspos := inverseCert_scale hinv
  funext j
  have ey := hry j
  have ez := hrz j
  rw [hcode] at ey
  have ee : certScale p * y' j = certScale p * z' j := ey.trans ez.symm
  exact Int.eq_of_mul_eq_mul_left (by omega) ee

public theorem nodup_toListFrom : ∀ n i : Nat, (Bitset.toListFrom n i).Nodup := by
  refine Bitset.bitInduction₁ (P := fun n => ∀ i, (Bitset.toListFrom n i).Nodup) ?_ ?_
  · intro i
    rw [Bitset.toListFrom_step]
    exact List.nodup_nil
  · intro n hn ih i
    rw [Bitset.toListFrom_step, if_neg hn]
    by_cases hb : n % 2 = 1
    · rw [if_pos hb]
      refine List.nodup_cons.mpr ⟨?_, ih (i + 1)⟩
      intro hi
      have := Bitset.le_of_mem_toListFrom (n / 2) (i + 1) i hi
      omega
    · rw [if_neg hb]
      exact ih (i + 1)

public theorem nodup_toList (B : Bitset) : (Bitset.toList B).Nodup :=
  nodup_toListFrom B 0

public theorem nodup_map_on {a b : Type} (f : a -> b) : ∀ l : List a, l.Nodup ->
    (∀ x, x ∈ l -> ∀ y, y ∈ l -> f x = f y -> x = y) -> (l.map f).Nodup := by
  intro l
  induction l with
  | nil => intro _ _; exact List.nodup_nil
  | cons x xs ih =>
      intro hnd hinj
      have hn := List.nodup_cons.mp hnd
      refine List.nodup_cons.mpr ⟨?_, ih hn.2 ?_⟩
      · intro hm
        obtain ⟨y, hy, he⟩ := List.mem_map.mp hm
        have hyx := hinj y (List.mem_cons_of_mem _ hy) x (List.mem_cons_self ..) he
        exact hn.1 (hyx ▸ hy)
      · intro y hy z hz he
        exact hinj y (List.mem_cons_of_mem _ hy) z (List.mem_cons_of_mem _ hz) he

/-- A duplicate-free list included in another list cannot be longer. -/
public theorem nodup_length_le_of_subset {a : Type} [BEq a] [LawfulBEq a] :
    ∀ {l r : List a}, l.Nodup -> (∀ x, x ∈ l -> x ∈ r) -> l.length ≤ r.length := by
  intro l
  induction l with
  | nil => intro r _ _; simp
  | cons x xs ih =>
      intro r hnd hsub
      have hn := List.nodup_cons.mp hnd
      have hx : x ∈ r := hsub x (List.mem_cons_self ..)
      have hs : ∀ y, y ∈ xs -> y ∈ r.erase x := by
        intro y hy
        have hyx : y ≠ x := by
          intro he
          apply hn.1
          rw [← he]
          exact hy
        exact (List.mem_erase_of_ne hyx).mpr
          (hsub y (List.mem_cons_of_mem _ hy))
      have hlen := ih hn.2 hs
      rw [List.length_erase_of_mem hx] at hlen
      simp only [List.length_cons]
      have hrne : r.length ≠ 0 := by
        intro hr
        have hre := List.eq_nil_of_length_eq_zero hr
        rw [hre] at hx
        contradiction
      have hr : 0 < r.length := Nat.pos_of_ne_zero hrne
      omega

public theorem mem_of_subset_length_eq {a : Type} [BEq a] [LawfulBEq a]
    {l r : List a} (hnd : l.Nodup) (hsub : ∀ x, x ∈ l -> x ∈ r)
    (hlen : l.length = r.length) {x : a} (hx : x ∈ r) : x ∈ l := by
  apply Decidable.byContradiction
  intro hnot
  have hcons : (x :: l).Nodup := List.nodup_cons.mpr ⟨hnot, hnd⟩
  have hsub' : ∀ y, y ∈ x :: l -> y ∈ r := by
    intro y hy
    rcases List.mem_cons.mp hy with rfl | hy
    · exact hx
    · exact hsub y hy
  have hle := nodup_length_le_of_subset hcons hsub'
  simp only [List.length_cons, hlen] at hle
  omega

@[expose] public def rootColumnList (g p : Nat) : Nat -> List Nat
  | 0 => []
  | n + 1 => if rootColumnOK g p n then n :: rootColumnList g p n else rootColumnList g p n

public theorem mem_rootColumnList (g p d : Nat) : ∀ n,
    d ∈ rootColumnList g p n ↔ d < n ∧ rootColumnOK g p d = true := by
  intro n
  induction n with
  | zero => simp [rootColumnList]
  | succ n ih =>
      by_cases h : rootColumnOK g p n = true
      · rw [rootColumnList, if_pos h, List.mem_cons, ih]
        constructor
        · intro hd
          rcases hd with hd | hd
          · rw [hd]
            exact ⟨Nat.lt_succ_self n, h⟩
          · exact ⟨Nat.lt_succ_of_lt hd.1, hd.2⟩
        · intro hd
          rcases Nat.lt_or_eq_of_le (Nat.le_of_lt_succ hd.1) with hlt | heq
          · exact Or.inr ⟨hlt, hd.2⟩
          · exact Or.inl heq
      · rw [rootColumnList, if_neg h, ih]
        constructor
        · intro hd
          exact ⟨Nat.lt_succ_of_lt hd.1, hd.2⟩
        · intro hd
          have hlt : d < n := by
            rcases Nat.lt_or_eq_of_le (Nat.le_of_lt_succ hd.1) with hlt | heq
            · exact hlt
            · subst heq
              exact absurd hd.2 h
          exact ⟨hlt, hd.2⟩

public theorem length_rootColumnList (g p n : Nat) :
    (rootColumnList g p n).length = rootColumnCount g p n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      by_cases h : rootColumnOK g p n
      · rw [rootColumnList, if_pos h, List.length_cons, rootColumnCount, if_pos h, ih]
      · rw [rootColumnList, if_neg h, rootColumnCount, if_neg h, ih, Nat.add_zero]

public theorem canonicalCode_rootColumn {g p : Nat} (hinv : inverseCert g p = true)
    (b : Fin 4 -> Vec 8 Int) (hb : ∀ i, D11 (b i))
    (hgram : gramType g = basisGram b) {y : Vec 8 Int} (hy : D11 y)
    (hspan : InSpan b (qOf y)) : rootColumnOK g p (canonicalCode b y) = true := by
  let d := pairCode (pairing b y)
  have hdlt : d < 625 := pairCode_lt (pairing_five hb hy)
  have hdne : d ≠ 312 := pairCode_ne_mid hb hy hspan
  by_cases hhi : 312 < d
  · simpa [canonicalCode, d, hhi] using
      rootColumn_of_span hinv b hb hgram hy hspan hhi
  · have hlo : d < 312 := by omega
    let yn := AddCommGroup.neg y
    have hyn : D11 yn := D11_neg hy
    have hsn : InSpan b (qOf yn) := inSpan_neg hspan
    have hpair : pairing b yn = fun i => -(pairing b y i) := by
      funext i
      exact dot_neg_left y (b i)
    have hcode : pairCode (pairing b yn) = 624 - d := by
      rw [hpair]
      exact pairCode_neg (pairing_five hb hy)
    have htop : 312 < pairCode (pairing b yn) := by rw [hcode]; omega
    have hr := rootColumn_of_span hinv b hb hgram hyn hsn htop
    rw [hcode] at hr
    simpa [canonicalCode, d, hhi] using hr

/-- A zero checked cross form is an actual orthogonality relation between the
two root classes represented by its canonical columns. -/
public theorem dot_zero_of_cross {g p : Nat} (hinv : inverseCert g p = true)
    (b : Fin 4 -> Vec 8 Int) (hb : ∀ i, D11 (b i))
    (hgram : gramType g = basisGram b) {y z : Vec 8 Int} (hy : D11 y) (hz : D11 z)
    (hsy : InSpan b (qOf y)) (hsz : InSpan b (qOf z))
    (hcross : crossNum g p (canonicalCode b y) (canonicalCode b z) = 0) :
    dot y z = 0 := by
  let y' := canonicalRoot b y
  let z' := canonicalRoot b z
  have hy' : D11 y' := canonicalRoot_D11 b hy
  have hz' : D11 z' := canonicalRoot_D11 b hz
  have hsy' := canonicalRoot_span b hsy
  have hsz' := canonicalRoot_span b hsz
  have hry := scaled_recon_of_span hinv b hb hgram hy' hsy'
  have hrz := scaled_recon_of_span hinv b hb hgram hz' hsz'
  have hcy := canonicalRoot_code hb hy
  have hcz := canonicalRoot_code hb hz
  have hform : form4 (basisGram b)
      (coordNum p (pairCode (pairing b y')))
      (coordNum p (pairCode (pairing b z'))) = 0 := by
    rw [hcy, hcz, ← hgram]
    exact hcross
  have hdot : dot (comb4 (coordNum p (pairCode (pairing b y'))) b)
      (comb4 (coordNum p (pairCode (pairing b z'))) b) = 0 := by
    rw [← form4_basisGram]
    exact hform
  have hyvec : Vec.smul (certScale p) y' =
      comb4 (coordNum p (pairCode (pairing b y'))) b := funext hry
  have hzvec : Vec.smul (certScale p) z' =
      comb4 (coordNum p (pairCode (pairing b z'))) b := funext hrz
  rw [← hyvec, ← hzvec, dot_smul_left, dot_smul_right] at hdot
  have hsne : certScale p ≠ 0 := by have := inverseCert_scale hinv; omega
  have hdot' : dot y' z' = 0 := by
    rcases Int.mul_eq_zero.mp hdot with hs | hs
    · exact absurd hs hsne
    · rcases Int.mul_eq_zero.mp hs with hs | hs
      · exact absurd hs hsne
      · exact hs
  by_cases hyc : 312 < pairCode (pairing b y) <;>
    by_cases hzc : 312 < pairCode (pairing b z)
  · simpa [y', z', canonicalRoot, hyc, hzc] using hdot'
  · simpa [y', z', canonicalRoot, hyc, hzc, dot_neg_right] using hdot'
  · simpa [y', z', canonicalRoot, hyc, hzc, dot_neg_left] using hdot'
  · simpa [y', z', canonicalRoot, hyc, hzc, dot_neg_left, dot_neg_right] using hdot'

public theorem cross_eq_scaled_dot {g p : Nat} (hinv : inverseCert g p = true)
    (b : Fin 4 -> Vec 8 Int) (hb : ∀ i, D11 (b i))
    (hgram : gramType g = basisGram b) {y z : Vec 8 Int} (hy : D11 y) (hz : D11 z)
    (hsy : InSpan b (qOf y)) (hsz : InSpan b (qOf z)) :
    crossNum g p (canonicalCode b y) (canonicalCode b z) =
      certScale p * (certScale p * dot (canonicalRoot b y) (canonicalRoot b z)) := by
  let y' := canonicalRoot b y
  let z' := canonicalRoot b z
  have hy' : D11 y' := canonicalRoot_D11 b hy
  have hz' : D11 z' := canonicalRoot_D11 b hz
  have hsy' := canonicalRoot_span b hsy
  have hsz' := canonicalRoot_span b hsz
  have hry := scaled_recon_of_span hinv b hb hgram hy' hsy'
  have hrz := scaled_recon_of_span hinv b hb hgram hz' hsz'
  have hcy := canonicalRoot_code hb hy
  have hcz := canonicalRoot_code hb hz
  have hyvec : Vec.smul (certScale p) y' =
      comb4 (coordNum p (pairCode (pairing b y'))) b := funext hry
  have hzvec : Vec.smul (certScale p) z' =
      comb4 (coordNum p (pairCode (pairing b z'))) b := funext hrz
  rw [crossNum, ← hcy, ← hcz, hgram, form4_basisGram, ← hyvec, ← hzvec,
    dot_smul_left, dot_smul_right]

public theorem positiveData_of_case {b : Fin 4 -> Vec 8 Int} (hb : ∀ i, D11 (b i))
    (hind : Indep b) (hcase : gramCaseOK (gramCode b) = true) :
    let p := gramInversePack (gramCode b)
    inverseCert (gramCode b) p = true
      ∧ rootColumnCount (gramCode b) p 625 ≤ 12
      ∧ (rootColumnCount (gramCode b) p 625 = 12 ->
        quadColumnsOK (gramCode b) p = true) := by
  simp only [gramCaseOK] at hcase
  split at hcase
  · simp only [Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true',
      decide_eq_true_eq, decide_eq_false_iff_not] at hcase
    refine ⟨hcase.1.1, hcase.1.2, fun heq => ?_⟩
    rcases hcase.2 with hne | hquad
    · exact absurd heq hne
    · exact hquad
  · exact absurd hcase (badGram_impossible hb hind)

/-- The twelve classes of a block inject into the admissible canonical
columns.  The oracle's upper bound therefore holds at equality and activates
its orthogonal-quadruple certificate. -/
public theorem blockGramData {B : Bitset} (hB : D16 B)
    (hcases : ∀ g, g < 15625 -> gramCaseOK g = true) :
    ∃ (b : Fin 4 -> Vec 8 Int) (p : Nat),
      (∀ i, RootsOf B (b i)) ∧ Indep b
      ∧ (∀ x, RootsOf B x -> InSpan b (qOf x))
      ∧ inverseCert (gramCode b) p = true
      ∧ rootColumnCount (gramCode b) p 625 = 12
      ∧ quadColumnsOK (gramCode b) p = true := by
  obtain ⟨b, hbB, hind, hspan⟩ := hB.2.2
  have hb : ∀ i, D11 (b i) := fun i => (hbB i).1
  have hcase := hcases (gramCode b) (gramCode_lt hb)
  have hdata := positiveData_of_case hb hind hcase
  let p := gramInversePack (gramCode b)
  have hinv : inverseCert (gramCode b) p = true := hdata.1
  have hupper : rootColumnCount (gramCode b) p 625 ≤ 12 := hdata.2.1
  let L := Bitset.toList B
  let f : Nat -> Nat := fun x => canonicalCode b (repN x)
  have hmember : ∀ x, x ∈ L -> x < 120 ∧ x ∈ B := by
    intro x hx
    have hxB := (Bitset.mem_toList B x).mp hx
    exact ⟨lt_of_mem hB.1 hxB, hxB⟩
  have hspanRep : ∀ x, x ∈ L -> InSpan b (qOf (repN x)) := by
    intro x hx
    have hm := hmember x hx
    exact hspan (repN x) ⟨D11_repN hm.1, by rw [D12_repN hm.1]; exact hm.2⟩
  have hcol : ∀ x, x ∈ L -> rootColumnOK (gramCode b) p (f x) = true := by
    intro x hx
    exact canonicalCode_rootColumn hinv b hb (gramType_gramCode hb)
      (D11_repN (hmember x hx).1) (hspanRep x hx)
  have hinj : ∀ x, x ∈ L -> ∀ y, y ∈ L -> f x = f y -> x = y := by
    intro x hx y hy hxy
    have hxlt := (hmember x hx).1
    have hylt := (hmember y hy).1
    have hr := canonicalRoot_injective hinv b hb (gramType_gramCode hb)
      (D11_repN hxlt) (D11_repN hylt) (hspanRep x hx) (hspanRep y hy) hxy
    have hc := congrArg D12 hr
    rw [canonicalRoot_class b (D11_repN hxlt), canonicalRoot_class b (D11_repN hylt),
      ] at hc
    have hcv := congrArg Fin.val hc
    rw [D12_repN hxlt, D12_repN hylt] at hcv
    exact hcv
  have hnd : (L.map f).Nodup := nodup_map_on f L (nodup_toList B) hinj
  have hsub : ∀ d, d ∈ L.map f -> d ∈ rootColumnList (gramCode b) p 625 := by
    intro d hd
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hd
    have hc := hcol x hx
    have hc' := hc
    simp only [rootColumnOK, Bool.and_eq_true, decide_eq_true_eq] at hc'
    exact (mem_rootColumnList _ _ _ 625).mpr ⟨hc'.1.2, hc⟩
  have hlower := nodup_length_le_of_subset hnd hsub
  have hlen : (L.map f).length = 12 := by
    rw [List.length_map, Bitset.length_toList]
    exact hB.2.1
  rw [hlen, length_rootColumnList] at hlower
  have heq : rootColumnCount (gramCode b) p 625 = 12 := by omega
  exact ⟨b, p, hbB, hind, hspan, hinv, heq, hdata.2.2 heq⟩

/-- The oracle quadruple attached to an abstract block, retaining the basis and
column identities needed by the coverage half of the certificate. -/
public theorem block_oracle_quad {B : Bitset} (hB : D16 B)
    (hcases : ∀ g, g < 15625 -> gramCaseOK g = true) :
    ∃ (b : Fin 4 -> Vec 8 Int) (p : Nat) (q : Fin 4 -> Nat),
      (∀ i, D11 (b i))
      ∧ gramType (gramCode b) = basisGram b
      ∧ inverseCert (gramCode b) p = true
      ∧ (∀ x, RootsOf B x -> InSpan b (qOf x))
      ∧ (∀ y, D11 y -> InSpan b (qOf y) -> (D12 y).val ∈ B)
      ∧ quadColumnsOK (gramCode b) p = true
      ∧ (∀ i, q i < 120 ∧ q i ∈ B)
      ∧ (∀ i, canonicalCode b (repN (q i)) = quadColumn (gramQuad (gramCode b)) i)
      ∧ ∀ i j, i ≠ j -> dot (repN (q i)) (repN (q j)) = 0 := by
  obtain ⟨b, p, hbB, hind, hspanB, hinv, hcount, hquad⟩ := blockGramData hB hcases
  have hb : ∀ i, D11 (b i) := fun i => (hbB i).1
  have hgram := gramType_gramCode hb
  let L := Bitset.toList B
  let f : Nat -> Nat := fun x => canonicalCode b (repN x)
  have hmember : ∀ x, x ∈ L -> x < 120 ∧ x ∈ B := by
    intro x hx
    have hxB := (Bitset.mem_toList B x).mp hx
    exact ⟨lt_of_mem hB.1 hxB, hxB⟩
  have hspanRep : ∀ x, x ∈ L -> InSpan b (qOf (repN x)) := by
    intro x hx
    have hm := hmember x hx
    exact hspanB (repN x) ⟨D11_repN hm.1, by rw [D12_repN hm.1]; exact hm.2⟩
  have hcol : ∀ x, x ∈ L -> rootColumnOK (gramCode b) p (f x) = true := by
    intro x hx
    exact canonicalCode_rootColumn hinv b hb hgram
      (D11_repN (hmember x hx).1) (hspanRep x hx)
  have hinj : ∀ x, x ∈ L -> ∀ y, y ∈ L -> f x = f y -> x = y := by
    intro x hx y hy hxy
    have hxlt := (hmember x hx).1
    have hylt := (hmember y hy).1
    have hr := canonicalRoot_injective hinv b hb hgram
      (D11_repN hxlt) (D11_repN hylt) (hspanRep x hx) (hspanRep y hy) hxy
    have hc := congrArg D12 hr
    rw [canonicalRoot_class b (D11_repN hxlt), canonicalRoot_class b (D11_repN hylt)] at hc
    have hcv := congrArg Fin.val hc
    rw [D12_repN hxlt, D12_repN hylt] at hcv
    exact hcv
  have hnd : (L.map f).Nodup := nodup_map_on f L (nodup_toList B) hinj
  have hsub : ∀ d, d ∈ L.map f -> d ∈ rootColumnList (gramCode b) p 625 := by
    intro d hd
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hd
    have hc := hcol x hx
    have hc' := hc
    simp only [rootColumnOK, Bool.and_eq_true, decide_eq_true_eq] at hc'
    exact (mem_rootColumnList _ _ _ 625).mpr ⟨hc'.1.2, hc⟩
  have hlenL : (L.map f).length = 12 := by
    rw [List.length_map, Bitset.length_toList]
    exact hB.2.1
  have hlenR : (rootColumnList (gramCode b) p 625).length = 12 := by
    rw [length_rootColumnList, hcount]
  have hclosed : ∀ y, D11 y -> InSpan b (qOf y) -> (D12 y).val ∈ B := by
    intro y hy hsy
    have hcOK := canonicalCode_rootColumn hinv b hb hgram hy hsy
    have hcOK' := hcOK
    simp only [rootColumnOK, Bool.and_eq_true, decide_eq_true_eq] at hcOK'
    have hmR : canonicalCode b y ∈ rootColumnList (gramCode b) p 625 :=
      (mem_rootColumnList _ _ _ 625).mpr ⟨hcOK'.1.2, hcOK⟩
    have hmL := mem_of_subset_length_eq hnd hsub (hlenL.trans hlenR.symm) hmR
    obtain ⟨x, hx, hcodeX⟩ := List.mem_map.mp hmL
    have hxlt := (hmember x hx).1
    have hr := canonicalRoot_injective hinv b hb hgram hy (D11_repN hxlt) hsy
      (hspanRep x hx) hcodeX.symm
    have hc := congrArg D12 hr
    rw [canonicalRoot_class b hy, canonicalRoot_class b (D11_repN hxlt)] at hc
    have hcv := congrArg Fin.val hc
    rw [D12_repN hxlt] at hcv
    rw [hcv]
    exact (hmember x hx).2
  have hquadOK := hquad
  simp only [quadColumnsOK, Bool.and_eq_true] at hquad
  have hroot : ∀ i : Fin 4,
      rootColumnOK (gramCode b) p (quadColumn (gramQuad (gramCode b)) i) = true :=
    fun i => allFin_true _ hquad.1.1 i
  have hex : ∀ i : Fin 4, ∃ x, x ∈ L ∧ f x = quadColumn (gramQuad (gramCode b)) i := by
    intro i
    have hr := hroot i
    have hr' := hr
    simp only [rootColumnOK, Bool.and_eq_true, decide_eq_true_eq] at hr'
    have hmR : quadColumn (gramQuad (gramCode b)) i ∈
        rootColumnList (gramCode b) p 625 :=
      (mem_rootColumnList _ _ _ 625).mpr ⟨hr'.1.2, hr⟩
    have hmL := mem_of_subset_length_eq hnd hsub (hlenL.trans hlenR.symm) hmR
    obtain ⟨x, hx, he⟩ := List.mem_map.mp hmL
    exact ⟨x, hx, he⟩
  let q : Fin 4 -> Nat := fun i => Classical.choose (hex i)
  have hq : ∀ i, q i ∈ L ∧ f (q i) = quadColumn (gramQuad (gramCode b)) i :=
    fun i => Classical.choose_spec (hex i)
  have hqcode : ∀ i,
      canonicalCode b (repN (q i)) = quadColumn (gramQuad (gramCode b)) i := by
    intro i
    simpa [f] using (hq i).2
  refine ⟨b, p, q, hb, hgram, hinv, hspanB, hclosed, hquadOK,
    fun i => hmember (q i) (hq i).1, hqcode, fun i j hij => ?_⟩
  have hpairs := allFin_true _ (allFin_true _ hquad.1.2 i) j
  simp only [Bool.or_eq_true, decide_eq_true_eq] at hpairs
  have hcross : crossNum (gramCode b) p
      (quadColumn (gramQuad (gramCode b)) i)
      (quadColumn (gramQuad (gramCode b)) j) = 0 := by
    rcases hpairs with heq | hzero
    · exact absurd heq hij
    · exact hzero
  apply dot_zero_of_cross hinv b hb hgram
    (D11_repN (hmember (q i) (hq i).1).1)
    (D11_repN (hmember (q j) (hq j).1).1)
    (hspanRep (q i) (hq i).1) (hspanRep (q j) (hq j).1)
  rw [hqcode i, hqcode j]
  exact hcross

/-- Every abstract `D16` block contains four pairwise orthogonal classes. -/
public theorem block_has_orthogonal_quad {B : Bitset} (hB : D16 B)
    (hcases : ∀ g, g < 15625 -> gramCaseOK g = true) :
    ∃ q : Fin 4 -> Nat,
      (∀ i, q i < 120 ∧ q i ∈ B)
      ∧ ∀ i j, i ≠ j -> dot (repN (q i)) (repN (q j)) = 0 := by
  obtain ⟨b, p, q, hb, hgram, hinv, hspan, hclosed, hquad, hq, hcode, horth⟩ :=
    block_oracle_quad hB hcases
  exact ⟨q, hq, horth⟩

public theorem factor4 (k a b c d : Int) :
    k * a + k * b + k * c + k * d = k * (a + b + c + d) := by
  rw [Int.mul_add, Int.mul_add, Int.mul_add]

public theorem canonical_dot_square (b : Fin 4 -> Vec 8 Int) (y z : Vec 8 Int) :
    dot (canonicalRoot b y) (canonicalRoot b z) *
      dot (canonicalRoot b y) (canonicalRoot b z) = dot y z * dot y z := by
  by_cases hy : 312 < pairCode (pairing b y) <;>
    by_cases hz : 312 < pairCode (pairing b z)
  · simp [canonicalRoot, hy, hz]
  · simp [canonicalRoot, hy, hz, dot_neg_right, Int.neg_mul_neg]
  · simp [canonicalRoot, hy, hz, dot_neg_left, Int.neg_mul_neg]
  · simp [canonicalRoot, hy, hz, dot_neg_left, dot_neg_right]

/-- Span containment is transitive for the four-by-four bases used by `D16`.
The proof expands the two rational combinations and exchanges their finite
sums. -/
public theorem inSpan4_trans {a b : Fin 4 -> Vec 8 Int}
    (hab : ∀ i, InSpan b (qOf (a i))) {y : Vec 8 Int}
    (hya : InSpan a (qOf y)) : InSpan b (qOf y) := by
  let C : Fin 4 -> Vec 4 Rat := fun i => Classical.choose (hab i)
  have hC : ∀ i j, qOf (a i) j = qComb b (C i) j :=
    fun i j => Classical.choose_spec (hab i) j
  obtain ⟨c, hc⟩ := hya
  let d : Vec 4 Rat := fun j => Vec.sum (fun i => c i * C i j)
  refine ⟨d, fun t => ?_⟩
  calc
    qOf y t = qComb a c t := hc t
    _ = Vec.sum (fun i => c i * qOf (a i) t) := rfl
    _ = Vec.sum (fun i => c i * qComb b (C i) t) := by
      exact Vec.sum_congr (fun i => congrArg (fun z => c i * z) (hC i t))
    _ = Vec.sum (fun i => c i * Vec.sum (fun j => C i j * ((b j t : Int) : Rat))) := rfl
    _ = Vec.sum (fun i => Vec.sum (fun j => c i * (C i j * ((b j t : Int) : Rat)))) := by
      exact Vec.sum_congr (fun i => Vec.mul_sum (c i)
        (fun j => C i j * ((b j t : Int) : Rat)))
    _ = Vec.sum (fun i => Vec.sum (fun j => (c i * C i j) * ((b j t : Int) : Rat))) := by
      exact Vec.sum_congr (fun i => Vec.sum_congr (fun j => (Rat.mul_assoc _ _ _).symm))
    _ = Vec.sum (fun j => Vec.sum (fun i => (c i * C i j) * ((b j t : Int) : Rat))) :=
      Vec.sum_exchange _
    _ = Vec.sum (fun j => (Vec.sum (fun i => c i * C i j)) * ((b j t : Int) : Rat)) := by
      exact Vec.sum_congr (fun j => (Vec.sum_mul
        (fun i => c i * C i j) ((b j t : Int) : Rat)).symm)
    _ = qComb b d t := rfl

/-- The selected orthogonal quadruple satisfies Parseval for every class of
the original block; this is the coverage clause of `quadColumnsOK` transported
back through the scaled inverse. -/
public theorem block_oracle_parseval {B : Bitset} (hB : D16 B)
    (hcases : ∀ g, g < 15625 -> gramCaseOK g = true) :
    ∃ (b : Fin 4 -> Vec 8 Int) (q : Fin 4 -> Nat),
      (∀ i, q i < 120 ∧ q i ∈ B)
      ∧ (∀ i j, i ≠ j -> dot (repN (q i)) (repN (q j)) = 0)
      ∧ (∀ i, InSpan b (qOf (repN (q i))))
      ∧ (∀ y, D11 y -> InSpan b (qOf y) -> (D12 y).val ∈ B)
      ∧ ∀ w, w < 120 -> w ∈ B ->
        dot (repN w) (repN (q 0)) * dot (repN w) (repN (q 0))
          + dot (repN w) (repN (q 1)) * dot (repN w) (repN (q 1))
          + dot (repN w) (repN (q 2)) * dot (repN w) (repN (q 2))
          + dot (repN w) (repN (q 3)) * dot (repN w) (repN (q 3)) = 64 := by
  obtain ⟨b, p, q, hb, hgram, hinv, hspan, hclosed, hquadOK, hq, hcode, horth⟩ :=
    block_oracle_quad hB hcases
  have hs : ∀ i : Fin 4, InSpan b (qOf (repN (q i))) := by
    intro i
    exact hspan (repN (q i))
      ⟨D11_repN (hq i).1, by rw [D12_repN (hq i).1]; exact (hq i).2⟩
  refine ⟨b, q, hq, horth, hs, hclosed, fun w hwlt hwB => ?_⟩
  have hy : D11 (repN w) := D11_repN hwlt
  have hsy : InSpan b (qOf (repN w)) :=
    hspan (repN w) ⟨hy, by rw [D12_repN hwlt]; exact hwB⟩
  let d := canonicalCode b (repN w)
  have hdOK : rootColumnOK (gramCode b) p d = true :=
    canonicalCode_rootColumn hinv b hb hgram hy hsy
  have hdOK' := hdOK
  simp only [rootColumnOK, Bool.and_eq_true, decide_eq_true_eq] at hdOK'
  have hquad := hquadOK
  simp only [quadColumnsOK, Bool.and_eq_true] at hquad
  have hcov := allLt_true _ _ hquad.2 d hdOK'.1.2
  rw [hdOK] at hcov
  simp only [Bool.not_true, Bool.false_or, decide_eq_true_eq] at hcov
  have ecross : ∀ i : Fin 4,
      crossNum (gramCode b) p d (quadColumn (gramQuad (gramCode b)) i) =
        certScale p * (certScale p *
          dot (canonicalRoot b (repN w)) (canonicalRoot b (repN (q i)))) := by
    intro i
    have he := cross_eq_scaled_dot hinv b hb hgram hy (D11_repN (hq i).1) hsy (hs i)
    rw [hcode i] at he
    exact he
  rw [ecross 0, ecross 1, ecross 2, ecross 3] at hcov
  let k := certScale p * certScale p * certScale p * certScale p
  let a : Fin 4 -> Int := fun i =>
    dot (canonicalRoot b (repN w)) (canonicalRoot b (repN (q i)))
  have eterm : ∀ i : Fin 4,
      (certScale p * (certScale p * a i)) * (certScale p * (certScale p * a i)) =
        k * (a i * a i) := by
    intro i
    simp only [k]
    ac_rfl
  simp only [a] at eterm
  rw [eterm 0, eterm 1, eterm 2, eterm 3, factor4] at hcov
  have hk : k ≠ 0 := by
    have hsne : certScale p ≠ 0 := by have := inverseCert_scale hinv; omega
    exact Int.mul_ne_zero (Int.mul_ne_zero (Int.mul_ne_zero hsne hsne) hsne) hsne
  have hcan : a 0 * a 0 + a 1 * a 1 + a 2 * a 2 + a 3 * a 3 = 64 := by
    apply Int.eq_of_mul_eq_mul_left hk
    show k * (a 0 * a 0 + a 1 * a 1 + a 2 * a 2 + a 3 * a 3) = k * 64
    rw [hcov]
    simp only [k]
    ac_rfl
  simp only [a] at hcan
  rw [canonical_dot_square b (repN w) (repN (q 0)),
    canonical_dot_square b (repN w) (repN (q 1)),
    canonical_dot_square b (repN w) (repN (q 2)),
    canonical_dot_square b (repN w) (repN (q 3))] at hcan
  exact hcan

/-- Every `D16` block is exactly the closure of an orthogonal quadruple. -/
public theorem block_eq_quadSet {B : Bitset} (hB : D16 B)
    (hcases : ∀ g, g < 15625 -> gramCaseOK g = true) :
    ∃ q : Fin 4 -> Nat,
      (∀ i, q i < 120 ∧ q i ∈ B)
      ∧ (∀ i j, i ≠ j -> dot (repN (q i)) (repN (q j)) = 0)
      ∧ B = quadSet (q 0) (q 1) (q 2) (q 3) := by
  obtain ⟨b, q, hq, horth, hqspan, hclosed, hparse⟩ := block_oracle_parseval hB hcases
  have o01 := horth 0 1 (by decide)
  have o02 := horth 0 2 (by decide)
  have o03 := horth 0 3 (by decide)
  have o12 := horth 1 2 (by decide)
  have o13 := horth 1 3 (by decide)
  have o23 := horth 2 3 (by decide)
  refine ⟨q, hq, horth, Bitset.ext (fun w => ?_)⟩
  constructor
  · intro hwB
    have hwlt := lt_of_mem hB.1 hwB
    have hrec := recon_of_parseval
      (quad_gram (hq 0).1 (hq 1).1 (hq 2).1 (hq 3).1 o01 o02 o03 o12 o13 o23)
      (D11_repN hwlt).2 (hparse w hwlt hwB)
    exact (mem_quadSet_iff_inSpan (hq 0).1 (hq 1).1 (hq 2).1 (hq 3).1
      o01 o02 o03 o12 o13 o23 hwlt).mpr (inSpan_of_recon _ _ hrec)
  · intro hwQ
    have hwlt := lt_of_mem (classSet_quadSet (hq 0).1 (hq 1).1 (hq 2).1 (hq 3).1) hwQ
    have hsQ := (mem_quadSet_iff_inSpan (hq 0).1 (hq 1).1 (hq 2).1 (hq 3).1
      o01 o02 o03 o12 o13 o23 hwlt).mp hwQ
    have hsB : InSpan b (qOf (repN w)) := inSpan4_trans hqspan hsQ
    have hm := hclosed (repN w) (D11_repN hwlt) hsB
    rw [D12_repN hwlt] at hm
    exact hm

/-! ### Sorting the certified quadruple -/

@[expose] public def Mem4 (x a b c d : Nat) : Prop :=
  (x = a ∨ x = b) ∨ (x = c ∨ x = d)

public theorem mem4_pairSort (x a b c d : Nat) :
    Mem4 x (Nat.min a b) (Nat.max a b) (Nat.min c d) (Nat.max c d) ↔
      Mem4 x a b c d := by
  by_cases h1 : a ≤ b <;> by_cases h2 : c ≤ d <;>
    simp [Mem4, Nat.min_def, Nat.max_def, h1, h2, or_left_comm, or_comm]

public theorem mem4_crossSort (x a b c d : Nat) :
    Mem4 x (Nat.min a c) (Nat.min b d) (Nat.max a c) (Nat.max b d) ↔
      Mem4 x a b c d := by
  by_cases h1 : a ≤ c <;> by_cases h2 : b ≤ d <;>
    simp [Mem4, Nat.min_def, Nat.max_def, h1, h2, or_left_comm, or_comm]

public theorem mem4_middleSort (x a b c d : Nat) :
    Mem4 x a (Nat.min b c) (Nat.max b c) d ↔ Mem4 x a b c d := by
  by_cases h : b ≤ c <;>
    simp [Mem4, Nat.min_def, Nat.max_def, h, or_left_comm, or_comm]

@[expose] public def sortQuad (q : Fin 4 -> Nat) : Fin 4 -> Nat :=
  let s0 := Nat.min (q 0) (q 1)
  let s1 := Nat.max (q 0) (q 1)
  let s2 := Nat.min (q 2) (q 3)
  let s3 := Nat.max (q 2) (q 3)
  let t0 := Nat.min s0 s2
  let t1 := Nat.min s1 s3
  let t2 := Nat.max s0 s2
  let t3 := Nat.max s1 s3
  let r1 := Nat.min t1 t2
  let r2 := Nat.max t1 t2
  fun i => match i with
    | 0 => t0
    | 1 => r1
    | 2 => r2
    | 3 => t3

public theorem sortQuad_mem4 (q : Fin 4 -> Nat) (x : Nat) :
    Mem4 x (sortQuad q 0) (sortQuad q 1) (sortQuad q 2) (sortQuad q 3) ↔
      Mem4 x (q 0) (q 1) (q 2) (q 3) := by
  let s0 := Nat.min (q 0) (q 1)
  let s1 := Nat.max (q 0) (q 1)
  let s2 := Nat.min (q 2) (q 3)
  let s3 := Nat.max (q 2) (q 3)
  let t0 := Nat.min s0 s2
  let t1 := Nat.min s1 s3
  let t2 := Nat.max s0 s2
  let t3 := Nat.max s1 s3
  change Mem4 x t0 (Nat.min t1 t2) (Nat.max t1 t2) t3 ↔ _
  calc
    Mem4 x t0 (Nat.min t1 t2) (Nat.max t1 t2) t3 ↔ Mem4 x t0 t1 t2 t3 :=
      mem4_middleSort x t0 t1 t2 t3
    _ ↔ Mem4 x s0 s1 s2 s3 := mem4_crossSort x s0 s1 s2 s3
    _ ↔ Mem4 x (q 0) (q 1) (q 2) (q 3) :=
      mem4_pairSort x (q 0) (q 1) (q 2) (q 3)

public theorem sortQuad_strict (q : Fin 4 -> Nat)
    (h01 : q 0 ≠ q 1) (h02 : q 0 ≠ q 2) (h03 : q 0 ≠ q 3)
    (h12 : q 1 ≠ q 2) (h13 : q 1 ≠ q 3) (h23 : q 2 ≠ q 3) :
    sortQuad q 0 < sortQuad q 1 ∧ sortQuad q 1 < sortQuad q 2
      ∧ sortQuad q 2 < sortQuad q 3 := by
  simp only [sortQuad, Nat.min_def, Nat.max_def]
  repeat first | split | omega

public theorem mem_quadSet_mem4 (a b c d w : Nat) :
    w ∈ quadSet a b c d ↔
      ((w ∈ arow a ∧ w ∈ arow b ∧ w ∈ arow c ∧ w ∈ arow d)
        ∨ Mem4 w a b c d) := by
  rw [mem_quadSet]
  simp only [Mem4]
  constructor <;> intro h <;> rcases h with h | h
  · exact Or.inl h
  · rcases h with h | h | h | h
    · exact Or.inr (Or.inl (Or.inl h))
    · exact Or.inr (Or.inl (Or.inr h))
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr h))
  · exact Or.inl h
  · rcases h with (h | h) | (h | h)
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (Or.inl h))
    · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
    · exact Or.inr (Or.inr (Or.inr (Or.inr h)))

/-- `quadSet` depends only on the four-element membership predicate, not on
the order in which the four classes are supplied. -/
public theorem quadSet_eq_of_mem4 {a b c d e f g h : Nat}
    (hsame : ∀ x, Mem4 x a b c d ↔ Mem4 x e f g h) :
    quadSet a b c d = quadSet e f g h := by
  apply Bitset.ext
  intro w
  rw [mem_quadSet_mem4, mem_quadSet_mem4]
  constructor
  · intro hw
    rcases hw with hall | hm
    · have hAll : ∀ x, Mem4 x a b c d -> w ∈ arow x := by
        intro x hx
        rcases hx with (rfl | rfl) | (rfl | rfl)
        · exact hall.1
        · exact hall.2.1
        · exact hall.2.2.1
        · exact hall.2.2.2
      exact Or.inl ⟨hAll e ((hsame e).mpr (by simp [Mem4])),
        hAll f ((hsame f).mpr (by simp [Mem4])),
        hAll g ((hsame g).mpr (by simp [Mem4])),
        hAll h ((hsame h).mpr (by simp [Mem4]))⟩
    · exact Or.inr ((hsame _).mp hm)
  · intro hw
    rcases hw with hall | hm
    · have hAll : ∀ x, Mem4 x e f g h -> w ∈ arow x := by
        intro x hx
        rcases hx with (rfl | rfl) | (rfl | rfl)
        · exact hall.1
        · exact hall.2.1
        · exact hall.2.2.1
        · exact hall.2.2.2
      exact Or.inl ⟨hAll a ((hsame a).mp (by simp [Mem4])),
        hAll b ((hsame b).mp (by simp [Mem4])),
        hAll c ((hsame c).mp (by simp [Mem4])),
        hAll d ((hsame d).mp (by simp [Mem4]))⟩
    · exact Or.inr ((hsame _).mpr hm)

public theorem mem4_exists_fin (q : Fin 4 -> Nat) (x : Nat) :
    Mem4 x (q 0) (q 1) (q 2) (q 3) ↔ ∃ i : Fin 4, x = q i := by
  constructor
  · intro h
    rcases h with (h | h) | (h | h)
    · exact ⟨0, h⟩
    · exact ⟨1, h⟩
    · exact ⟨2, h⟩
    · exact ⟨3, h⟩
  · rintro ⟨i, rfl⟩
    exact fin4 (P := fun i => Mem4 (q i) (q 0) (q 1) (q 2) (q 3))
      (Or.inl (Or.inl rfl)) (Or.inl (Or.inr rfl))
      (Or.inr (Or.inl rfl)) (Or.inr (Or.inr rfl)) i

public theorem strict4_ne (r : Fin 4 -> Nat)
    (h01 : r 0 < r 1) (h12 : r 1 < r 2) (h23 : r 2 < r 3) :
    ∀ i j, i ≠ j -> r i ≠ r j := by
  intro i
  refine fin4 (P := fun i => ∀ j, i ≠ j -> r i ≠ r j) ?_ ?_ ?_ ?_ i
  · intro j
    refine fin4 (P := fun j => (0 : Fin 4) ≠ j -> r 0 ≠ r j)
      ?_ ?_ ?_ ?_ j <;> omega
  · intro j
    refine fin4 (P := fun j => (1 : Fin 4) ≠ j -> r 1 ≠ r j)
      ?_ ?_ ?_ ?_ j <;> omega
  · intro j
    refine fin4 (P := fun j => (2 : Fin 4) ≠ j -> r 2 ≠ r j)
      ?_ ?_ ?_ ?_ j <;> omega
  · intro j
    refine fin4 (P := fun j => (3 : Fin 4) ≠ j -> r 3 ≠ r j)
      ?_ ?_ ?_ ?_ j <;> omega

/-- Completeness of the block table: every abstract block is one of its 3150
entries.  Sorting is only the enumeration convention; `quadSet_eq_of_mem4`
shows it changes no closure. -/
public theorem block_in_table {B : Bitset} (hB : D16 B)
    (hcases : ∀ g, g < 15625 -> gramCaseOK g = true) :
    ∃ i : Nat, i < 3150 ∧ blkAt i = B := by
  obtain ⟨q, hq, horth, hBq⟩ := block_eq_quadSet hB hcases
  have qne : ∀ i j, i ≠ j -> q i ≠ q j := by
    intro i j hij heq
    have ho := horth i j hij
    rw [heq, (D11_repN (hq j).1).2] at ho
    omega
  have hstrict := sortQuad_strict q
    (qne 0 1 (by decide)) (qne 0 2 (by decide)) (qne 0 3 (by decide))
    (qne 1 2 (by decide)) (qne 1 3 (by decide)) (qne 2 3 (by decide))
  let r := sortQuad q
  have hrmem : ∀ i : Fin 4, ∃ j : Fin 4, r i = q j := by
    intro i
    apply (mem4_exists_fin q (r i)).mp
    apply (sortQuad_mem4 q (r i)).mp
    exact fin4 (P := fun i => Mem4 (r i) (r 0) (r 1) (r 2) (r 3))
      (Or.inl (Or.inl rfl)) (Or.inl (Or.inr rfl))
      (Or.inr (Or.inl rfl)) (Or.inr (Or.inr rfl)) i
  let k : Fin 4 -> Fin 4 := fun i => Classical.choose (hrmem i)
  have hk : ∀ i, r i = q (k i) := fun i => Classical.choose_spec (hrmem i)
  have hr : ∀ i, r i < 120 ∧ r i ∈ B := by
    intro i
    rw [hk i]
    exact hq (k i)
  have hrinj : ∀ i j, i ≠ j -> r i ≠ r j :=
    strict4_ne r hstrict.1 hstrict.2.1 hstrict.2.2
  have horthR : ∀ i j, i ≠ j -> dot (repN (r i)) (repN (r j)) = 0 := by
    intro i j hij
    have hkne : k i ≠ k j := by
      intro heq
      apply hrinj i j hij
      rw [hk i, hk j, heq]
    rw [hk i, hk j]
    exact horth (k i) (k j) hkne
  have hset : quadSet (r 0) (r 1) (r 2) (r 3) =
      quadSet (q 0) (q 1) (q 2) (q 3) :=
    quadSet_eq_of_mem4 (fun x => sortQuad_mem4 q x)
  have hBR : B = quadSet (r 0) (r 1) (r 2) (r 3) := hBq.trans hset.symm
  have hcard : Bitset.card (quadSet (r 0) (r 1) (r 2) (r 3)) = 12 := by
    rw [← hBR]
    exact hB.2.1
  obtain ⟨i, hi, hit⟩ := quad_in_table (hr 0).1 (hr 1).1 (hr 2).1 (hr 3).1
    hstrict.1 hstrict.2.1 hstrict.2.2
    (horthR 0 1 (by decide)) (horthR 0 2 (by decide)) (horthR 0 3 (by decide))
    (horthR 1 2 (by decide)) (horthR 1 3 (by decide)) (horthR 2 3 (by decide)) hcard
  exact ⟨i, hi, hit.trans hBR.symm⟩

/-! ### Exhausting the finite Gram register -/

@[expose] public def gramRange (a n : Nat) : Bool :=
  allLt (fun k => gramCaseOK (a + k)) n

public theorem gramRange_append {a m n : Nat}
    (h : gramRange a m = true) (h' : gramRange (a + m) n = true) :
    gramRange a (m + n) = true := by
  apply allLt_of
  intro k hk
  by_cases hkm : k < m
  · exact allLt_true _ _ h k hkm
  · have hkn : k - m < n := by omega
    have ht := allLt_true _ _ h' (k - m) hkn
    have heq : (a + m) + (k - m) = a + k := by omega
    simpa [gramRange, heq] using ht

public theorem gramRange_true {a n g : Nat} (h : gramRange a n = true)
    (ha : a ≤ g) (hg : g < a + n) : gramCaseOK g = true := by
  have ht := allLt_true _ _ h (g - a) (by omega)
  have heq : a + (g - a) = g := by omega
  simpa [gramRange, heq] using ht

end UorAtlas.Census

