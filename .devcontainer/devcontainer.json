{
  "name": "LexLean",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.97.1",
      "profile": "minimal"
    },
    "ghcr.io/guiyomh/features/just:0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "leanprover.lean4",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.procMacro.enable": true,
        "rust-analyzer.cargo.allFeatures": true,
        "search.exclude": {
          "**/target": true
        },
        "files.watcherExclude": {
          "**/target/**": true
        }
      }
    }
  },
  "remoteEnv": {
    "PATH": "/home/codespace/.elan/bin:/home/codespace/.cargo/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "rustup toolchain install 1.97.1 --profile minimal --component rustfmt --component clippy && cargo install cargo-deny --locked && curl https://elan.lean-lang.org/elan-init.sh -sSf | sh -s -- -y --default-toolchain none && ~/.elan/bin/elan toolchain install leanprover/lean4:v4.32.1"
}
